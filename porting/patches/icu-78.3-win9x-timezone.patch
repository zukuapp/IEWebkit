--- a/source/common/wintz.cpp
+++ b/source/common/wintz.cpp
@@ -87,6 +87,93 @@
 U_CAPI const char* U_EXPORT2
 uprv_detectWindowsTimeZone()
 {
+#if defined(U_IEWEBKIT_WIN9X)
+    // Win9x uses ANSI registry values and shorter zone keys. This follows the
+    // pre-Vista discovery strategy in ICU58, retaining ICU78's current zone data.
+    TIME_ZONE_INFORMATION current = {};
+    if (GetTimeZoneInformation(&current) == TIME_ZONE_ID_INVALID)
+        return nullptr;
+    char currentName[256] = {};
+    HKEY currentKey = nullptr;
+    if (RegOpenKeyExA(HKEY_LOCAL_MACHINE,
+            "SYSTEM\\CurrentControlSet\\Control\\TimeZoneInformation", 0,
+            KEY_QUERY_VALUE, &currentKey) != ERROR_SUCCESS)
+        return nullptr;
+    DWORD type = 0, bytes = sizeof(currentName);
+    LONG query = RegQueryValueExA(currentKey, "StandardName", nullptr, &type,
+        reinterpret_cast<LPBYTE>(currentName), &bytes);
+    RegCloseKey(currentKey);
+    if (query != ERROR_SUCCESS || type != REG_SZ || !bytes || bytes > sizeof(currentName)
+        || currentName[bytes - 1] != 0)
+        return nullptr;
+
+    UErrorCode status = U_ZERO_ERROR;
+    StackUResourceBundle mapping;
+    ures_openDirectFillIn(mapping.getAlias(), nullptr, "windowsZones", &status);
+    ures_getByKey(mapping.getAlias(), "mapTimezones", mapping.getAlias(), &status);
+    if (U_FAILURE(status)) return nullptr;
+    while (ures_hasNext(mapping.getAlias())) {
+        StackUResourceBundle zone;
+        ures_getNextResource(mapping.getAlias(), zone.getAlias(), &status);
+        if (U_FAILURE(status)) return nullptr;
+        const char* windowsID = ures_getKey(zone.getAlias());
+        char path[512] = "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Time Zones\\";
+        size_t rootLength = strlen(path), nameLength = strlen(windowsID);
+        if (rootLength + nameLength >= sizeof(path)) continue;
+        memcpy(path + rootLength, windowsID, nameLength + 1);
+        char* suffix = strstr(path + rootLength, " Standard Time");
+        if (suffix && suffix[14] == 0) *suffix = 0;
+        HKEY key = nullptr;
+        if (RegOpenKeyExA(HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key) != ERROR_SUCCESS)
+            continue;
+        char standardName[256] = {};
+        bytes = sizeof(standardName); type = 0;
+        query = RegQueryValueExA(key, "Std", nullptr, &type,
+            reinterpret_cast<LPBYTE>(standardName), &bytes);
+        bool nameMatches = query == ERROR_SUCCESS && type == REG_SZ && bytes
+            && bytes <= sizeof(standardName) && standardName[bytes - 1] == 0
+            && strcmp(currentName, standardName) == 0;
+        REG_TZI_FORMAT rules = {};
+        bytes = sizeof(rules); type = 0;
+        query = RegQueryValueExA(key, "TZI", nullptr, &type,
+            reinterpret_cast<LPBYTE>(&rules), &bytes);
+        RegCloseKey(key);
+        if (!nameMatches || query != ERROR_SUCCESS || type != REG_BINARY
+            || bytes != sizeof(rules) || current.Bias != rules.Bias)
+            continue;
+        bool datesMatch = memcmp(&current.StandardDate, &rules.StandardDate, sizeof(SYSTEMTIME)) == 0
+            && memcmp(&current.DaylightDate, &rules.DaylightDate, sizeof(SYSTEMTIME)) == 0;
+        if (!datesMatch) {
+            // Disabling automatic DST must not silently re-enable it via CLDR.
+            if (!current.StandardDate.wMonth && !current.DaylightDate.wMonth) {
+                if (current.Bias < -24 * 60 || current.Bias > 24 * 60) return nullptr;
+                LONG offset = -current.Bias;
+                char fixed[16];
+                snprintf(fixed, sizeof(fixed), "GMT%c%02ld:%02ld", offset < 0 ? '-' : '+',
+                    labs(offset) / 60, labs(offset) % 60);
+                return uprv_strdup(fixed);
+            }
+            continue;
+        }
+        char region[3] = {};
+        int regionLength = GetLocaleInfoA(GetUserDefaultLCID(), LOCALE_SISO3166CTRYNAME,
+            region, sizeof(region));
+        const char16_t* id = nullptr;
+        int32_t length = 0;
+        if (regionLength == 3)
+            id = ures_getStringByKey(zone.getAlias(), region, &length, &status);
+        if (!id || U_FAILURE(status)) {
+            status = U_ZERO_ERROR;
+            id = ures_getStringByKey(zone.getAlias(), "001", &length, &status);
+        }
+        if (U_FAILURE(status)) return nullptr;
+        int32_t first = 0;
+        while (first < length && id[first] && id[first] != u' ') ++first;
+        CharString result;
+        return result.appendInvariantChars(id, first, status).cloneData(status);
+    }
+    return nullptr;
+#else
     // We first try to obtain the time zone directly by using the TimeZoneKeyName field of the DYNAMIC_TIME_ZONE_INFORMATION struct.
     DYNAMIC_TIME_ZONE_INFORMATION dynamicTZI;
     uprv_memset(&dynamicTZI, 0, sizeof(dynamicTZI));
@@ -325,6 +412,7 @@
     // will return nullptr if the above look-up fails.
     CharString icuTZStr;
     return icuTZStr.appendInvariantChars(icuTZ16, tzLen, status).cloneData(status);
+#endif // U_IEWEBKIT_WIN9X
 }
 
 U_NAMESPACE_END
