--- a/Source/WTF/wtf/win/FileHandleWin.cpp
+++ b/Source/WTF/wtf/win/FileHandleWin.cpp
@@ -89,10 +89,33 @@
     if (!m_handle)
         return false;
 
+#if defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0600
+    if (offset < 0) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return false;
+    }
+
+    // Pre-Vista has no SetFileInformationByHandle. As with seek/read/write,
+    // callers must serialize access to this handle's shared file pointer.
+    auto position = seek(0, FileSeekOrigin::Current);
+    if (!position || !seek(offset, FileSeekOrigin::Beginning))
+        return false;
+
+    bool success = SetEndOfFile(*m_handle);
+    DWORD error = success ? NO_ERROR : GetLastError();
+    auto restored = seek(static_cast<int64_t>(*position), FileSeekOrigin::Beginning);
+    if (!success) {
+        // Restoration must not hide the original truncation failure.
+        SetLastError(error);
+        return false;
+    }
+    return restored.has_value();
+#else
     FILE_END_OF_FILE_INFO eofInfo;
     eofInfo.EndOfFile.QuadPart = offset;
 
     return SetFileInformationByHandle(*m_handle, FileEndOfFileInfo, &eofInfo, sizeof(FILE_END_OF_FILE_INFO));
+#endif
 }
 
 std::optional<uint64_t> FileHandle::seek(int64_t offset, FileSeekOrigin origin)
