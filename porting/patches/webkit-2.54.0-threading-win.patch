+static bool legacyMutexTryLock(PlatformMutex& mutex)
+{
+    DWORD expected = 0;
+    return mutex.owner.compare_exchange_strong(expected, GetCurrentThreadId(), std::memory_order_acquire, std::memory_order_relaxed);
+}
+
+static void legacyMutexLock(PlatformMutex& mutex)
+{
+    while (!legacyMutexTryLock(mutex))
+        Sleep(1);
+}
+
+static void legacyMutexUnlock(PlatformMutex& mutex)
+{
+    RELEASE_ASSERT(mutex.owner.load(std::memory_order_relaxed) == GetCurrentThreadId());
+    mutex.owner.store(0, std::memory_order_release);
+}
+
+struct WindowsLegacyConditionWaiter {
+    HANDLE event;
+    WindowsLegacyConditionWaiter* next { nullptr };
+    bool signaled { false };
+};
+
+static void legacyConditionPopAndSignal(PlatformCondition& condition)
+{
+    auto* waiter = condition.first;
+    if (!waiter)
+        return;
+    condition.first = waiter->next;
+    if (!condition.first)
+        condition.last = nullptr;
+    waiter->signaled = true;
+    // Keep the queue lock until SetEvent completes: a timeout must not close
+    // or recycle this handle between removing the waiter and signaling it.
+    RELEASE_ASSERT(SetEvent(waiter->event));
+}
+
+static bool legacyConditionWait(PlatformCondition& condition, Mutex& mutex, DWORD interval)
+{
+    WindowsLegacyConditionWaiter waiter { CreateEventA(nullptr, FALSE, FALSE, nullptr) };
+    RELEASE_ASSERT(waiter.event);
+    legacyMutexLock(condition.queueLock);
+    if (condition.last)
+        condition.last->next = &waiter;
+    else
+        condition.first = &waiter;
+    condition.last = &waiter;
+    ++condition.activeWaiters;
+    // Register before releasing the predicate mutex. Signalers cannot miss
+    // this waiter even when they run before WaitForSingleObject starts.
+    mutex.unlock();
+    legacyMutexUnlock(condition.queueLock);
+
+    DWORD result = WaitForSingleObject(waiter.event, interval);
+    legacyMutexLock(condition.queueLock);
+    if (!waiter.signaled) {
+        WindowsLegacyConditionWaiter* previous = nullptr;
+        auto* current = condition.first;
+        while (current && current != &waiter) {
+            previous = current;
+            current = current->next;
+        }
+        RELEASE_ASSERT(current == &waiter);
+        if (previous)
+            previous->next = waiter.next;
+        else
+            condition.first = waiter.next;
+        if (condition.last == &waiter)
+            condition.last = previous;
+    }
+    --condition.activeWaiters;
+    bool signaled = waiter.signaled;
+    legacyMutexUnlock(condition.queueLock);
+    RELEASE_ASSERT(CloseHandle(waiter.event));
+    mutex.lock();
+    RELEASE_ASSERT(result == WAIT_OBJECT_0 || result == WAIT_TIMEOUT);
+    RELEASE_ASSERT(result != WAIT_OBJECT_0 || signaled);
+    // On a timeout/signal race, queue-lock order decides the winner. A signal
+    // already assigned to this waiter is never consumed by a later waiter.
+    return signaled;
+}
